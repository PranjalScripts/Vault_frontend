diff --git a/node_modules/expo-server/build/cjs/vendor/http.js b/node_modules/expo-server/build/cjs/vendor/http.js
index 4ffaac4..683c247 100644
--- a/node_modules/expo-server/build/cjs/vendor/http.js
+++ b/node_modules/expo-server/build/cjs/vendor/http.js
@@ -49,6 +49,11 @@ function createRequestHandler(params, setup) {
             await respond(res, response);
         }
         catch (error) {
+            // Navigation/reload can close the client socket during response streaming.
+            // Do not forward an expected cancellation to Metro's error middleware.
+            if (error?.code === 'ERR_STREAM_PREMATURE_CLOSE' && (req.aborted || res.destroyed)) {
+                return;
+            }
             // http doesn't support async functions, so we have to pass along the
             // error manually using next().
             next(error);
