+package expo.modules.notifications.notifications.presentation.builders
+
+import android.content.Context
+import android.graphics.Color
+import android.widget.RemoteViews
+import androidx.core.app.NotificationCompat
+import expo.modules.notifications.R
+import expo.modules.notifications.notifications.interfaces.INotificationContent
+
+/** Custom content only: Expo retains native delivery, scheduling and response PendingIntents. */
+internal object VaultNotificationLayout {
+  fun apply(context: Context, builder: NotificationCompat.Builder, identifier: String, content: INotificationContent) {
+    if (!identifier.startsWith("vault-local-")) return
+    val kind = content.body?.optString("kind")
+    if (kind != "task" && kind != "study") return
+    val label = context.getString(if (kind == "study") R.string.vault_notification_study else R.string.vault_notification_task)
+    fun view(layout: Int) = RemoteViews(context.packageName, layout).apply {
+      setTextViewText(R.id.vault_notification_title, content.title)
+      setTextViewText(R.id.vault_notification_body, content.text)
+      setTextViewText(R.id.vault_notification_label, label)
+    }
+    builder
+      .setSmallIcon(R.drawable.vault_notification_icon)
+      .setColor(Color.rgb(42, 125, 103))
+      .setCategory(NotificationCompat.CATEGORY_REMINDER)
+      .setVisibility(NotificationCompat.VISIBILITY_PRIVATE)
+      .setAutoCancel(true)
+      .setOngoing(false)
+      .setStyle(NotificationCompat.DecoratedCustomViewStyle())
+      .setCustomContentView(view(R.layout.vault_notification_compact))
+      .setCustomHeadsUpContentView(view(R.layout.vault_notification_compact))
+      .setCustomBigContentView(view(R.layout.vault_notification_expanded))
+    // Android may show this redacted version when lock-screen content is hidden.
+    builder.setPublicVersion(NotificationCompat.Builder(context, builder.build().channelId)
+      .setSmallIcon(R.drawable.vault_notification_icon)
+      .setContentTitle(context.getString(R.string.vault_notification_app))
+      .setContentText(context.getString(R.string.vault_notification_private))
+      .setContentIntent(builder.build().contentIntent)
+      .build())
+  }
+}
