{
  "expo": {
    "name": "Vault",
    "slug": "vault",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vault",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.pranjal.vault"
    },
    "android": {
      "package": "com.pranjal.vault",
      "versionCode": 2,
      "permissions": ["android.permission.REQUEST_INSTALL_PACKAGES"],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FBFAF4",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png"
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBFAF4",
          "image": "./assets/images/icon.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "android": {
            "imageWidth": 200,
            "dark": {
              "backgroundColor": "#FBFAF4",
              "image": "./assets/images/icon.png"
            }
          }
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Vault to use Face ID to protect access to your app."
        }
      ],
      "./plugins/withVaultNotificationResources"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "edc01505-c903-4305-adaa-be880390fba9"
      }
    },
    "owner": "pranjalt363"
  }
}
